{
  "name": "react-apex-grid",
  "version": "0.0.0",
  "description": "React wrapper for apex-grid, the framework-agnostic web component data grid",
  "keywords": [
    "react",
    "react-component",
    "data-grid",
    "data-table",
    "apex-grid",
    "web-component"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "ApexCharts",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./enterprise": {
      "types": "./enterprise/index.d.ts",
      "default": "./enterprise/index.js"
    }
  },
  "sideEffects": ["./generated/*.js", "./generated/enterprise/*.js"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apexcharts/apex-grid.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/apexcharts/apex-grid/issues"
  },
  "homepage": "https://github.com/apexcharts/apex-grid/tree/main/packages/react#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "apex-grid": "^3.5.0 || ^4.0.0 || ^5.0.0",
    "apex-grid-enterprise": ">=0.10.0 <1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "apex-grid-enterprise": {
      "optional": true
    }
  },
  "dependencies": {
    "@lit/react": "^1.0.8"
  }
}

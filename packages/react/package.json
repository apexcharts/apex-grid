{
  "name": "react-apex-grid",
  "version": "0.1.0",
  "description": "React wrapper for apex-grid, the framework-agnostic web component data grid",
  "keywords": [
    "react",
    "react-component",
    "data-grid",
    "data-table",
    "apex-grid",
    "web-component"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "ApexCharts",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": ["**/generated/*.js"],
  "scripts": {
    "generate": "node scripts/generate.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "apex-grid": "^3.4.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@lit/react": "^1.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "apex-grid": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
